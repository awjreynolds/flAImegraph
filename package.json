{
  "name": "flaimegraph",
  "version": "0.1.0",
  "description": "Open agent-cost interchange, exact valuation and standard flame-graph exports",
  "repository": { "type": "git", "url": "https://github.com/awjreynolds/flAImegraph.git" },
  "homepage": "https://github.com/awjreynolds/flAImegraph#readme",
  "bugs": { "url": "https://github.com/awjreynolds/flAImegraph/issues" },
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22.0.0" },
  "bin": { "flaimegraph": "dist/cli.js" },
  "exports": { ".": "./dist/index.js" },
  "types": "dist/index.d.ts",
  "files": ["dist", "spec", "vendor", "examples", "docs", "CONTEXT.md", "README.md", "LICENSE", "NOTICE"],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm test",
    "cli": "tsx src/cli.ts"
  },
  "dependencies": { "ajv": "8.20.0", "protobufjs": "8.8.0" },
  "devDependencies": { "typescript": "7.0.2", "tsx": "4.23.13", "@types/node": "26.4.1" }
}
