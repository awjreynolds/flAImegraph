{
  "name": "flaimegraph",
  "version": "0.3.0",
  "description": "Open agent cost, context and operation interchange with deep execution profiles",
  "repository": {
    "type": "git",
    "url": "https://github.com/awjreynolds/flAImegraph.git"
  },
  "homepage": "https://github.com/awjreynolds/flAImegraph#readme",
  "bugs": {
    "url": "https://github.com/awjreynolds/flAImegraph/issues"
  },
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "flaimegraph": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "spec",
    "vendor",
    "examples",
    "docs",
    "tools/verify-otlp",
    "CONTEXT.md",
    "README.md",
    "LICENSE",
    "NOTICE",
    "tools/context-producer-python",
    "tools/viewer",
    "viewer",
    "tools/dogfood-v02.ts",
    "tools/dogfood-v03.ts",
    "tools/dogfood-native-v03.ts",
    "tools/demo-operation-routing.ts",
    "tools/verify-pi-operations.ts"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm test",
    "cli": "tsx src/cli.ts"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "file-type": "21.3.4",
    "protobufjs": "8.8.0"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "esbuild": "^0.28.2",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
