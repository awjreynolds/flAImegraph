        "wall_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$"
        },
        "monotonic_ns": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "data": {
          "$ref": "#/$defs/data"
        }
      },
      "required": [
        "schema_version",
        "dataset_id",
        "producer_id",
        "epoch",
        "sequence",
        "event_id",
        "wall_at",
        "monotonic_ns",
        "data"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "sequence": {
                "const": 0
              }
            },
            "required": [
              "sequence"
            ]
          },
          "then": {
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "epoch"
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "data": {
                "type": "object",
                "properties": {
                  "kind": {
                    "not": {
                      "const": "epoch"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "lifecycle-issue": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "action_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    },
    "lifecycle": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "0.5.0"
        },
        "kind": {
          "const": "lifecycle"
        },
        "dataset_id": {
          "type": "string",
          "minLength": 1
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lifecycle-event"
          }
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lifecycle-issue"
          }
        }
      },
      "required": [
        "schema_version",
        "kind",
        "dataset_id",
        "events",
        "issues"
      ],
      "additionalProperties": false
    },
    "journal-frame": {
      "type": "object",
      "properties": {
        "event": {
          "$ref": "#/$defs/lifecycle-event"
        },
        "previous_hash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "event",
        "previous_hash",
        "hash"
      ],
      "additionalProperties": false
    }
  }
}
